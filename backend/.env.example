# Copy to .env for local development. Never commit real secrets.
MEDVERSE_ENV=development
MEDVERSE_DATABASE_URL=postgresql+psycopg://medverse:medverse_dev_password@localhost:5432/medverse
MEDVERSE_REDIS_URL=redis://localhost:6379/0
MEDVERSE_CORS_ORIGINS=["http://localhost:3000"]
MEDVERSE_SESSION_TTL_HOURS=12
MEDVERSE_COOKIE_SECURE=false
MEDVERSE_CONTENT_DIR=../content
